rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    // Institutional Root: The Spirit School Samundri
    match /schools/tss-main-school {
      // Branding and Identity are public for the login terminal
      allow get: if true;
      // Admins and staff can update school-level metadata
      allow update: if isSignedIn();

      // Settings sub-collection (PrintConfig, Profile)
      match /settings/{settingId} {
        allow get, list: if true;
        allow write: if isSignedIn();
      }

      // Recursive catch-all for all school-owned data (Students, Exams, Marks, etc.)
      match /{allPaths=**} {
        allow read, list, write: if isSignedIn();
      }
    }

    // Legacy Support & Global Registry Roots
    match /users/{userId} { allow read, write: if isSignedIn(); }
    match /students/{id} { allow read, write: if isSignedIn(); }
    match /marks/{id} { allow read, write: if isSignedIn(); }
    match /results/{id} { allow read, write: if isSignedIn(); }
    match /exams/{id} { allow read, write: if isSignedIn(); }

    // Ensure users can read their own documents even outside the school tree
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }
  }
}